{
  "name": "@zen-ext-mcp/extension",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "node build.mjs",
    "clean": "rm -rf dist web-ext-artifacts",
    "run": "web-ext run --source-dir=dist --start-url=about:debugging",
    "lint": "web-ext lint --source-dir=dist",
    "sign": "web-ext sign --source-dir=dist --channel=unlisted --api-key=$AMO_KEY --api-secret=$AMO_SECRET"
  },
  "dependencies": {
    "@zen-ext-mcp/shared": "*"
  },
  "devDependencies": {
    "@types/firefox-webext-browser": "^120.0.4",
    "web-ext": "^8.3.0"
  }
}
